pragma solidity ^0.8.17;

import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/token/ERC20/IERC20.sol";

/**
 * @title ReferralManager
 * @notice Manages referral registration, reward calculation for ICO and lending, and reward claiming.
 * @dev Only authorized contracts (owner or whitelisted) can register referrals and accrue rewards.
 */
contract ReferralManager is Ownable {
    constructor() Ownable(msg.sender) {}

    // ---------------------------------------------------------------------
    // Mappings
    // ---------------------------------------------------------------------
    // user => referrer
    mapping(address => address) public referrerOf;
    // referrer => accumulated reward tokens (pending claim)
    mapping(address => uint256) public rewards;
    // authorized contracts that can call registerReferral / accrueReward
    mapping(address => bool) public isAuthorized;

    // ---------------------------------------------------------------------
    // Token handling
    // ---------------------------------------------------------------------
    IERC20 public rewardToken;

    // ---------------------------------------------------------------------
    // Reward rates (basis points, i.e., 1% = 100)
    // ---------------------------------------------------------------------
    uint256 public icoRewardRateBP = 500; // default 5%
    uint256 public lendingRewardRateBP = 300; // default 3%

    // ---------------------------------------------------------------------
    // Events
    // ---------------------------------------------------------------------
    event Referred(address indexed user, address indexed referrer);
    event RewardAccrued(address indexed referrer, uint256 amount);
    event RewardClaimed(address indexed referrer, uint256 amount);
    event Authorized(address indexed account, bool status);
    event ICORewardEarned(address indexed referrer, uint256 amount);
    event LendingRewardEarned(address indexed referrer, uint256 amount);

    // ---------------------------------------------------------------------
    // Modifiers
    // ---------------------------------------------------------------------
    modifier onlyAuthorized() {
        require(isAuthorized[msg.sender] || msg.sender == owner(), "not authorized");
        _;
    }

    // ---------------------------------------------------------------------
    // Owner configuration functions
    // ---------------------------------------------------------------------
    function setAuthorized(address account, bool status) external onlyOwner {
        isAuthorized[account] = status;
        emit Authorized(account, status);
    }

    function setRewardToken(IERC20 _token) external onlyOwner {
        rewardToken = _token;
    }

    function setICORewardRateBP(uint256 _rateBP) external onlyOwner {
        icoRewardRateBP = _rateBP;
    }

    function setLendingRewardRateBP(uint256 _rateBP) external onlyOwner {
        lendingRewardRateBP = _rateBP;
    }

    // ---------------------------------------------------------------------
    // Core referral functions
    // ---------------------------------------------------------------------
    function registerReferral(address user, address referrer) external onlyAuthorized {
        require(user != address(0) && referrer != address(0), "zero addr");
        require(user != referrer, "cannot refer self");
        require(referrerOf[user] == address(0), "already referred");
        referrerOf[user] = referrer;
        emit Referred(user, referrer);
    }

    /**
     * @notice Calculates ICO reward for a given purchase amount (in ABCD token units) and attributes it to the referrer.
     * @param purchaseAmount Amount of ABCD tokens purchased by the referred user.
     * @return reward Amount of reward tokens allocated.
     */
    function calculateICOReward(uint256 purchaseAmount) external onlyAuthorized returns (uint256 reward) {
        address user = msg.sender; // assuming caller is the ICO contract which passes purchase amount
        address ref = referrerOf[user];
        require(ref != address(0), "no referrer");
        reward = (purchaseAmount * icoRewardRateBP) / 10000;
        _accrueReward(ref, reward);
        emit ICORewardEarned(ref, reward);
    }

    /**
     * @notice Calculates lending reward based on interest generated for a loan.
     * @param interestGenerated Amount of interest (in ABCD tokens) generated by the loan.
     * @return reward Amount of reward tokens allocated to the referrer.
     */
    function calculateLendingReward(address user, uint256 interestGenerated) external onlyAuthorized returns (uint256 reward) {
        address ref = referrerOf[user];
        require(ref != address(0), "no referrer");
        reward = (interestGenerated * lendingRewardRateBP) / 10000;
        _accrueReward(ref, reward);
        emit LendingRewardEarned(ref, reward);
    }

    // ---------------------------------------------------------------------
    // Internal reward handling
    // ---------------------------------------------------------------------
    function _accrueReward(address referrer, uint256 amount) internal {
        rewards[referrer] += amount;
        emit RewardAccrued(referrer, amount);
    }

    // ---------------------------------------------------------------------
    // Claim function
    // ---------------------------------------------------------------------
    function claimReward() external {
        uint256 amount = rewards[msg.sender];
        require(amount > 0, "no rewards");
        require(address(rewardToken) != address(0), "token not set");
        rewards[msg.sender] = 0;
        rewardToken.transfer(msg.sender, amount);
        emit RewardClaimed(msg.sender, amount);
    }
}
