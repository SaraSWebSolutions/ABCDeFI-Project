# Copy the canonical deployment manifest for the selected network. Do not use
# browser-exposed private keys or stale localhost addresses.
VITE_API_BASE_URL=/api
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
VITE_NETWORK_NAME=Hardhat Local
# Explicitly enables local wallet-signature authentication in a Vite dev server.
# It is ignored by production builds.
VITE_AUTH_MODE=development
VITE_ABCD_TOKEN_ADDRESS=
VITE_LOAN_MANAGER_ADDRESS=
VITE_LOAN_MARKETPLACE_ADDRESS=
VITE_EMI_MANAGER_ADDRESS=
VITE_COLLATERAL_VAULT_ADDRESS=
VITE_LENDING_ADDRESS=
VITE_LIQUIDATION_ADDRESS=
VITE_PRESALE_ADDRESS=
VITE_TREASURY_ADDRESS=
VITE_VESTING_ADDRESS=
VITE_REFERRAL_ADDRESS=
VITE_BONUS_ENGINE_ADDRESS=
VITE_MARKETPLACE_ADDRESS=
VITE_PARTICIPANT_NFT_ADDRESS=
VITE_LOAN_NFT_ADDRESS=
VITE_REPUTATION_NFT_ADDRESS=
VITE_GURU_NFT_ADDRESS=
VITE_BONUS_MANAGER_ADDRESS=

# Deployment-only public protocol parameters. These are read by
# scripts/deploy-ecosystem.ts and never exposed as VITE_ browser configuration.
LENDING_LIQUIDITY=10000000
TOKEN_RATE_PER_ETH=1000

# Server-only configuration (never prefix secrets with VITE_).
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_LEVEL_NAME=id-and-liveness
SESSION_SIGNING_SECRET=
CORS_ORIGIN=http://localhost:5173

# BSC Testnet Lending V2 deployment preparation. Every value is owner-supplied
# and validated; no address, route, price, or funding amount has a default.
# This manifest path must be distinct from the active local deployments.json.
BSC_TESTNET_RPC_URL=
BSC_TESTNET_DEPLOYMENT_MANIFEST_PATH=
BSC_TESTNET_DEPLOYER=
BSC_TESTNET_ABCD_TOKEN=
BSC_TESTNET_TREASURY=
BSC_TESTNET_BNB_USD_FEED=
BSC_TESTNET_ABCD_USD_FEED=
BSC_TESTNET_BNB_USD_HEARTBEAT_SECONDS=
BSC_TESTNET_ABCD_USD_HEARTBEAT_SECONDS=
BSC_TESTNET_WBNB=
BSC_TESTNET_PANCAKESWAP_ROUTER=
BSC_TESTNET_PANCAKESWAP_ROUTER_VERSION=
BSC_TESTNET_LIQUIDATION_POOL=
BSC_TESTNET_LIQUIDATION_ROUTE=
BSC_TESTNET_LIQUIDATION_DEADLINE_SECONDS=
BSC_TESTNET_CONFIG_ADMIN=
BSC_TESTNET_RESERVE_FUNDING_WEI=
BSC_TESTNET_POOL_LIQUIDITY_WEI=
BSC_TESTNET_REFERRAL_ALLOWANCE_WEI=
BSC_TESTNET_MARKETING_REWARD_FUNDER=
BSC_TESTNET_ROUTE_PROBE_WBNB_WEI=
BSC_TESTNET_ROUTE_PROBE_MIN_ABCD_OUT_WEI=

# Canonical 1B ABCD BSC Testnet token. All wallet and authority values require
# explicit owner approval. The existing token can reissue only after a burn and
# never above 1B; acknowledge that existing source behavior explicitly.
BSC_TESTNET_ABCD_MANIFEST_PATH=
BSC_TESTNET_ABCD_DEPLOYER=
BSC_TESTNET_ABCD_OWNER=
BSC_TESTNET_ABCD_DEFAULT_ADMIN=
BSC_TESTNET_ABCD_MINTER=
BSC_TESTNET_ABCD_BURNER=
BSC_TESTNET_ABCD_PAUSER=
BSC_TESTNET_ABCD_INFRASTRUCTURE_WALLET=
BSC_TESTNET_ABCD_LIQUIDITY_WALLET=
BSC_TESTNET_ABCD_MARKETING_WALLET=
BSC_TESTNET_ABCD_CONTRACTS_WALLET=
BSC_TESTNET_ABCD_COMMUNITY_WALLET=
BSC_TESTNET_ABCD_EDUCATION_WALLET=
BSC_TESTNET_ABCD_CONTINGENCY_WALLET=
BSC_TESTNET_ABCD_RESERVE_WALLET=
BSC_TESTNET_ABCD_MINTING_POLICY=
