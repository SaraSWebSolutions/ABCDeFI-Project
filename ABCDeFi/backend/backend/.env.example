# Copy to .env for local development. Keep all real secrets in the deployment
# secret manager; never commit a populated .env file.
NODE_ENV=development
# Set to development only for the local wallet-signature flow. Production
# rejects AUTH_MODE=development at startup.
AUTH_MODE=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/abcdefi
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
FRONTEND_URL=http://localhost:5173
LENDING_MANIFEST_PATH=
LENDING_INDEXER_CONFIRMATIONS=2
LENDING_INDEXER_BLOCK_RANGE=250
LENDING_INDEXER_POLL_INTERVAL_MS=5000
LENDING_INDEXER_RETRY_ATTEMPTS=3
LENDING_INDEXER_RETRY_DELAY_MS=250
ALLOWED_CHAINS=31337,97,56
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
