{
  "name": "abcdefi-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test backend/backend/__tests__/*.test.cjs scripts/test-dashboard-routing.mjs scripts/test-auth-session.mjs scripts/test-ico-v2-ux.mjs scripts/test-legion-credential-dashboard.mjs scripts/test-legion-nft-v2-dashboard.mjs scripts/test-franchise-foundation-ux.mjs scripts/test-abcd-nft-marketplace-ux.mjs scripts/test-legion-marketplace-v2-ux.mjs scripts/test-treasury-v2-ux.mjs scripts/test-canonical-admin-ux.mjs",
    "hardhat": "hardhat",
    "compile:contracts": "hardhat compile",
    "test:contracts": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy-ecosystem.ts --network localhost",
    "deploy:lending-v2:local": "hardhat run scripts/deploy-lending-v2-local.ts --network localhost",
    "deploy:legion-credential:local": "hardhat run scripts/deploy-legion-credential-local.ts --network localhost",
    "deploy:abcd-nft-marketplace:local": "hardhat run scripts/deploy-abcd-nft-marketplace-local.ts --network localhost",
    "deploy:legion-marketplace:local": "hardhat run scripts/deploy-legion-marketplace-local.ts --network localhost",
    "deploy:treasury-v2:local": "hardhat run scripts/deploy-treasury-v2-local.ts --network localhost",
    "deploy:phase12:composed:local": "hardhat run scripts/deploy-phase12-composed-local.ts --network localhost",
    "e2e:legion-marketplace:local": "hardhat run scripts/run-legion-marketplace-local-e2e.ts --network localhost",
    "e2e:treasury-v2:local": "hardhat run scripts/run-treasury-v2-local-e2e.ts --network localhost",
    "e2e:admin:local": "hardhat run scripts/run-canonical-admin-local-e2e.ts --network localhost",
    "e2e:abcd-nft-marketplace:local": "hardhat run scripts/run-abcd-nft-marketplace-local-e2e.ts --network localhost",
    "e2e:legion-credential:local": "hardhat run scripts/run-legion-credential-local-e2e.ts --network localhost",
    "validate:legion:bsc-testnet": "hardhat run scripts/validate-legion-bsc-testnet.ts --network bscTestnet",
    "deploy:legion:bsc-testnet": "hardhat run scripts/deploy-legion-credential-bsc-testnet.ts --network bscTestnet",
    "verify:legion:bsc-testnet": "hardhat run scripts/verify-legion-credential-bsc-testnet.ts --network bscTestnet",
    "verify:abcd:bsc-testnet": "hardhat run scripts/verify-abcd-bsc-testnet.ts --network bscTestnet",
    "validate:abcd:bsc-testnet": "hardhat run scripts/validate-abcd-bsc-testnet-config.ts --network bscTestnet",
    "deploy:abcd:bsc-testnet": "hardhat run scripts/deploy-abcd-bsc-testnet.ts --network bscTestnet",
    "validate:lending-v2:bsc-testnet": "hardhat run scripts/validate-lending-v2-bsc-testnet-config.ts --network bscTestnet",
    "deploy:lending-v2:bsc-testnet": "hardhat run scripts/deploy-lending-v2-bsc-testnet.ts --network bscTestnet",
    "deploy:sepolia": "hardhat run scripts/deploy-ecosystem.ts --network sepolia",
    "deploy:bsc-testnet": "hardhat run scripts/deploy-ecosystem.ts --network bscTestnet",
    "deploy:bsc-mainnet": "hardhat run scripts/deploy-ecosystem.ts --network bscMainnet",
    "backend": "node backend/backend/server.js",
    "backend:seed-admin:development": "node backend/backend/scripts/seedDevelopmentAdmin.cjs",
    "backend:ensure-admin:development": "node backend/backend/scripts/ensureDevelopmentAdmin.cjs",
    "backend:reset-admin:development": "node backend/backend/scripts/resetDevelopmentAdmin.cjs",
    "backend:diagnose-auth:development": "node backend/backend/scripts/diagnoseDevelopmentAuth.cjs",
    "backend:indexer": "npm --prefix backend/backend run indexer",
    "backend:indexer:v2": "node backend/backend/scripts/runLendingV2Indexer.cjs",
    "backend:indexer:legion-v2": "node backend/backend/scripts/runLegionCredentialIndexer.cjs",
    "backend:indexer:legion-nft-v2": "node backend/backend/scripts/runLegionNFTV2Indexer.cjs",
    "backend:indexer:abcd-nft-marketplace-v2": "node backend/backend/scripts/runABCDMarketplaceIndexer.cjs",
    "backend:indexer:legion-marketplace-v2": "node backend/backend/scripts/runLegionMarketplaceIndexer.cjs",
    "backend:indexer:treasury-v2": "node backend/backend/scripts/runTreasuryV2Indexer.cjs",
    "backend:franchise-indexer": "npm --prefix backend/backend run franchise-indexer",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
    "all": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run backend\" \"npm run dev\"",
    "start": "npm run all"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.7.2",
    "canvas-confetti": "^1.9.4",
    "ethers": "^6.12.0",
    "lucide-react": "^0.309.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.3.0",
    "recharts": "^2.12.3",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.5.4",
    "chai": "^5.2.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.3.1",
    "hardhat": "^3.12.0",
    "mocha": "^11.7.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^5.0.0"
  }
}
