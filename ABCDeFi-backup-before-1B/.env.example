# Copy the canonical deployment manifest for the selected network. Do not use
# browser-exposed private keys or stale localhost addresses.
VITE_API_BASE_URL=/api
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
VITE_NETWORK_NAME=Hardhat Local
# Explicitly enables local wallet-signature authentication in a Vite dev server.
# It is ignored by production builds.
VITE_AUTH_MODE=development
VITE_ABCD_TOKEN_ADDRESS=
VITE_LOAN_MANAGER_ADDRESS=
VITE_LOAN_MARKETPLACE_ADDRESS=
VITE_EMI_MANAGER_ADDRESS=
VITE_COLLATERAL_VAULT_ADDRESS=
VITE_LENDING_ADDRESS=
VITE_LIQUIDATION_ADDRESS=
VITE_PRESALE_ADDRESS=
VITE_TREASURY_ADDRESS=
VITE_STAKING_ADDRESS=
VITE_VESTING_ADDRESS=
VITE_REFERRAL_ADDRESS=
VITE_BONUS_ENGINE_ADDRESS=
VITE_MARKETPLACE_ADDRESS=
VITE_PARTICIPANT_NFT_ADDRESS=
VITE_LOAN_NFT_ADDRESS=
VITE_REPUTATION_NFT_ADDRESS=
VITE_GURU_NFT_ADDRESS=
VITE_BONUS_MANAGER_ADDRESS=

# Deployment-only public protocol parameters. These are read by
# scripts/deploy-ecosystem.ts and never exposed as VITE_ browser configuration.
LENDING_LIQUIDITY=10000000
TOKEN_RATE_PER_ETH=1000

# Server-only configuration (never prefix secrets with VITE_).
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_LEVEL_NAME=id-and-liveness
SESSION_SIGNING_SECRET=
CORS_ORIGIN=http://localhost:5173
